<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reminders for calendar events and task deadlines. Runtime-requested on
         API 33+; the app works without it, silently scheduling nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EzygoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EzygoAttendance"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.EzygoAttendance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The widget chooser, started by the launcher when a widget is dropped.
             Exported because the launcher starts it from outside the app; it acts
             only on the widget id it is handed and shows no user data. -->
        <activity
            android:name=".widget.CompactWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_picker_title"
            android:theme="@style/Theme.EzygoAttendance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widget.LargeWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_picker_title"
            android:theme="@style/Theme.EzygoAttendance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Read-only access to a downloaded grade card, so it can be opened in a
             PDF viewer the user already has. Not exported: permission is granted
             per-Intent and per-URI, and only for the grade card directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widgets, one provider per footprint so each lands at the
             size its content needs. Exported because the AppWidget framework and
             the launcher deliver their broadcasts from outside the app. -->
        <receiver
            android:name=".widget.CompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>
        <receiver
            android:name=".widget.LargeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>
    </application>

</manifest>
